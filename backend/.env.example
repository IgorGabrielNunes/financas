# --- obrigatórias ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/financas
JWT_SECRET=troque-por-uma-string-aleatoria-de-64-chars
CORS_ORIGIN=http://localhost:5173          # em prod: https://seu-app.vercel.app (vírgula para várias)
PUBLIC_API_URL=http://localhost:3333        # usado para gerar links assinados de comprovante (driver local)

# --- opcionais ---
PORT=3333
DATABASE_SSL=false                          # true em produção (Neon); no-verify só como último recurso

# Armazenamento dos comprovantes: local (dev) | s3 (prod: Cloudflare R2, Supabase, S3...)
# ATENÇÃO: o disco do Render é efêmero — em produção use s3.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=financas-comprovantes
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Avisos (opcionais) — veja "Avisos" no README
# TELEGRAM_BOT_TOKEN=          (do @BotFather)
# TELEGRAM_BOT_USERNAME=       (sem @)
# TELEGRAM_WEBHOOK_SECRET=     (16+ caracteres aleatórios)
# AVISOS_TOKEN=                (24+ caracteres; só se usar cron externo em vez do Worker)
