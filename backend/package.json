{
  "name": "financas-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "node dist/core/migrate.js",
    "migrate:dev": "tsx src/core/migrate.ts",
    "user:create": "tsx src/scripts/create-user.ts",
    "user:create:prod": "node dist/scripts/create-user.js",
    "test": "vitest run src/modulos",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "vitest run src/e2e",
    "user:senha": "tsx src/scripts/reset-password.ts",
    "user:senha:prod": "node dist/scripts/reset-password.js",
    "telegram:webhook": "tsx src/scripts/telegram-webhook.ts",
    "telegram:webhook:prod": "node dist/scripts/telegram-webhook.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.5",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
